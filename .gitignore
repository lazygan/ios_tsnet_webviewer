# ---------------------------------------------------------------------------
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcresult
*.xcarchive
*.dSYM/
*.dSYM.zip
*.ipa
Payload/

# XcodeGen generates this from ios/project.yml
ios/*.xcodeproj/
ios/*.xcworkspace/

# gomobile output (regenerated by scripts/build_go.sh)
ios/Frameworks/

