.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Secrets and signing material — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.p12
*.pfx
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore

